# Discord Bot Credentials
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here

# Optional: Set a Guild (Server) ID for instant slash-command updates during development.
# Leave blank or remove to deploy commands globally across all servers.
DISCORD_GUILD_ID=

# Supabase Database Credentials (use the Service Role Key, NOT the public anon key)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
